# BizFlow: PRODUCTION profile (commercial deployment). Copy to .env on the server and fill in the
# blanks. Never commit the real .env. Check it with:  php artisan bizflow:preflight --profile=production
#
# Not for use yet: there is no real OCR provider, no payment provider and no approved pricing, and
# the SST decision is still open (see CLAUDE.md). This file exists so the contract is written down
# and kept honest by a test.

APP_NAME=BizFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

BIZFLOW_DEMO_MODE=false
BIZFLOW_REGISTRATION=open
BIZFLOW_REQUIRE_VERIFIED_EMAIL=true

# The reverse proxies in front of the app (IPs or CIDR ranges, comma separated).
TRUSTED_PROXIES=203.0.113.10
# TRUSTED_PROXIES_ALLOW_ALL=false

# One day to begin with; raise to a year once every subdomain is HTTPS.
HSTS_MAX_AGE=86400

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bizflow
# A dedicated user with data privileges on this schema only; migrations run as a separate user.
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# A real transport: smtp, ses, postmark or resend. Use a sending domain you control, with SPF, DKIM and DMARC.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Off until a real provider is selected, integrated and approved.
OCR_DRIVER=none

BILLING_PROVIDER=manual
BILLING_CONTACT_EMAIL=
