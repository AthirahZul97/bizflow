# BizFlow: PUBLIC PORTFOLIO DEMO profile. Copy to .env on the server and fill in the blanks.
# Never commit the real .env. Check it with:  php artisan bizflow:preflight --profile=demo
#
# Demo mode is restrictive by design: registration is closed, no invoice email is queued or sent,
# the email-based account flows are off, receipts are read by the labelled demo placeholder (no
# real OCR) and every page carries a demo banner and a noindex header. Accounts are provisioned by
# the operator, one business each. See docs/deployment.md before putting this online.

APP_NAME=BizFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.com

BIZFLOW_DEMO_MODE=true
BIZFLOW_REGISTRATION=closed
BIZFLOW_REQUIRE_VERIFIED_EMAIL=false

# The reverse proxies in front of the app (IPs or CIDR ranges, comma separated). Leave empty only if
# the app is reached directly. Never trust everything unless the app is reachable through the proxy alone.
TRUSTED_PROXIES=
# TRUSTED_PROXIES_ALLOW_ALL=false

# Start short, raise once HTTPS is confirmed everywhere.
HSTS_MAX_AGE=300

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bizflow_demo
# A dedicated user with data privileges on this schema only (see docs/deployment.md).
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Nothing may leave the application in the demo: log keeps messages in the log file.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Labelled demo placeholder. It does not read the uploaded file.
OCR_DRIVER=fake

BILLING_PROVIDER=manual
BILLING_CONTACT_EMAIL=
